<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name=".BluetoothDisablerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BluetoothDisable">

        <receiver
            android:name=".admin.AppDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".provisioning.GetProvisioningModeActivity"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".provisioning.AdminPolicyComplianceActivity"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BluetoothDisable"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".cover.calculator.CalculatorCoverActivity"
            android:exported="false"
            android:label="@string/launcher_name_calculator"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BluetoothDisable.Cover.Calculator" />

        <activity
            android:name=".cover.calendar.CalendarCoverActivity"
            android:exported="false"
            android:label="@string/launcher_name_calendar"
            android:launchMode="singleTask"
            android:theme="@style/Theme.BluetoothDisable.Cover.Calendar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".cover.calendar.CalendarCoverSetupActivity"
            android:exported="false"
            android:label="@string/calendar_setup_title"
            android:theme="@style/Theme.BluetoothDisable"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".cover.notes.NotesCoverActivity"
            android:exported="false"
            android:label="@string/launcher_name_notes"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BluetoothDisable.Cover.Notes"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".cover.notes.NotesCoverSetupActivity"
            android:exported="false"
            android:label="@string/notes_setup_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BluetoothDisable"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".cover.gallery.GalleryCoverActivity"
            android:exported="false"
            android:label="@string/launcher_name_gallery"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BluetoothDisable.Cover.Gallery" />

        <activity
            android:name=".cover.gallery.GalleryCoverSetupActivity"
            android:exported="false"
            android:label="@string/gallery_setup_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BluetoothDisable" />

        <activity-alias
            android:name="${applicationId}.LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="${applicationId}.LauncherAliasCalculator"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/calculator_icon"
            android:label="@string/launcher_name_calculator"
            android:roundIcon="@drawable/calculator_icon"
            android:targetActivity=".cover.calculator.CalculatorCoverActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="${applicationId}.LauncherAliasNotes"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/notes_icon"
            android:label="@string/launcher_name_notes"
            android:roundIcon="@drawable/notes_icon"
            android:targetActivity=".cover.notes.NotesCoverActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="${applicationId}.LauncherAliasCalendar"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/calendar_icon"
            android:label="@string/launcher_name_calendar"
            android:roundIcon="@drawable/calendar_icon"
            android:targetActivity=".cover.calendar.CalendarCoverActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="${applicationId}.LauncherAliasGallery"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/gallery_icon"
            android:label="@string/launcher_name_gallery"
            android:roundIcon="@drawable/gallery_icon"
            android:targetActivity=".cover.gallery.GalleryCoverActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".quicksettings.BluetoothDisableTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_bluetooth_disable"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
